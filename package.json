{
  "devDependencies": {
    "tailwindcss": "^3.4.18"
  },
  "scripts": {
    "server": "npm run server --prefix backend",
    "client": "npm start --prefix frontend",
    "dev": "concurrently \"npm:server\" \"npm:client\"",
    "install-client": "cd frontend && npm install",
    "build": "npm run install-client && CI=false npm run build --prefix frontend"
  },
  "dependencies": {
    "@google/genai": "^1.29.0",
    "concurrently": "^9.2.1",
    "cors": "^2.8.5",
    "express": "^5.1.0",
    "nodemon": "^3.1.10"
  }
}
